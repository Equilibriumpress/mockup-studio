{
  "manifest_version": 3,
  "name": "Mockup Studio Capture",
  "version": "0.7.0",
  "description": "Capture viewports, full pages, elements and URLs into Mockup Studio.",
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html", "default_title": "Mockup Studio Capture"},
  "content_scripts": [{"matches": ["https://equilibriumpress.github.io/mockup-studio/*"], "js": ["bridge.js"], "run_at": "document_idle"}]
}
